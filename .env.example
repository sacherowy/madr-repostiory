# --- Źródło prawdy ---
# Ścieżka do repozytorium ADR (pliki .md + frontmatter, wersjonowane gitem)
ADR_REPO_PATH=./data/adr-repo

# --- Projekcja (wtórna, odtwarzalna) ---
SQLITE_PATH=./data/index.sqlite

# --- Embeddingi: Gemini ---
# W Claude Code on the web działa na domyślnym poziomie sieci Trusted
# (host generativelanguage.googleapis.com jest objęty *.googleapis.com).
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=text-embedding-004

# --- Strategia podobieństwa ADR ---
# embedding (domyślnie, gdy puste) albo jev. Zmiana działa dopiero po restarcie.
# Przy jev tytuły i treść sekcji ADR trafiają do JEV_ENDPOINT (TokenRouter jako
# router + TypeSafe jako dostawca modelu). Błędna konfiguracja blokuje start.
# SIMILARITY_STRATEGY=embedding

# --- Jev (czytane tylko przy SIMILARITY_STRATEGY=jev; ignorowane przy embedding) ---
# Wymagane: absolutny URL https (http tylko dla localhost/127.0.0.1/[::1]); brak domyślnej wartości.
# JEV_ENDPOINT=https://api.tokenrouter.com/api/alpha/decisions
# Wymagany klucz API TokenRouter (nigdy nie jest logowany ani zwracany).
# JEV_API_KEY=
# Model (przypięta wersja, nie alias latest), domyślnie typesafe/jev-1.13
# JEV_MODEL=typesafe/jev-1.13
# Timeout pojedynczego zapytania w ms, liczba całkowita 100–60000 (domyślnie 10000)
# JEV_TIMEOUT_MS=10000
# Limit kandydatów na zapytanie, 1–1000 (domyślnie 100; „porównaj wszystkie” go pomija)
# JEV_MAX_CANDIDATES=100
# Równoległe zapytania do Jev, 1–16 (domyślnie 4)
# JEV_CONCURRENCY=4
# Budżet czasu całego żądania w ms, 1000–600000 i >= JEV_TIMEOUT_MS (domyślnie 120000)
# JEV_REQUEST_BUDGET_MS=120000

# --- Auth zespołowy (OIDC) — do uzupełnienia ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

PORT=3000
